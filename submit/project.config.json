{
  "description": "GOLFBROTHERS golf poster editor - native WeChat Mini Program delivery",
  "appid": "touristappid",
  "projectname": "golf-poster-submit",
  "compileType": "miniprogram",
  "miniprogramRoot": "miniprogram/",
  "libVersion": "3.3.5",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "scripts"
      }
    ]
